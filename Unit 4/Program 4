-- Create the Function
CREATE OR REPLACE FUNCTION get_square(p_num IN NUMBER) 
RETURN NUMBER AS
BEGIN
    RETURN p_num * p_num;
END;
/

-- Execute using a PL/SQL Block
DECLARE
    v_result NUMBER;
BEGIN
    v_result := get_square(6);
    DBMS_OUTPUT.PUT_LINE('The square is: ' || v_result);
END;
/

-- Execute on the Command Line without a PL/SQL block
SELECT get_square(8) AS square_value FROM DUAL;